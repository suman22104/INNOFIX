# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/innofix

# Security & Authentication (Required: change to a strong 32+ character random string in production)
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRE=30d

# AI Engine (Optional: Google Gemini API key. If omitted, falls back gracefully to offline heuristic NLP engine)
GEMINI_API_KEY=
